# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stratz API token — get one at https://stratz.com/api
STRATZ_API_KEY=your_stratz_jwt_token_here

# Set to "true" to skip real API calls and return mock data (useful during dev)
MOCK_CLAUDE=false
